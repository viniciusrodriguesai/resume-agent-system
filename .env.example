RESUME_PROFILE=demo
RESUME_EMBEDDING_ENABLED=true
RESUME_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RESUME_EMBEDDING_BACKEND=onnx
RESUME_EMBEDDING_DEVICE=cpu
RESUME_EMBEDDING_BATCH_SIZE=8
RESUME_NORMALIZE_EMBEDDINGS=true
RESUME_RERANKER_ENABLED=false
RESUME_DOCLING_ENABLED=false
RESUME_PRESIDIO_ENABLED=false
RESUME_TOP_K=3
RESUME_MAX_REQUIREMENTS=30
RESUME_MAX_CHUNK_CHARS=900
RESUME_MAX_DOCUMENT_CHARS=30000
RESUME_CACHE_ENABLED=true
RESUME_CACHE_TTL_SECONDS=86400
RESUME_STORE_RAW_DOCUMENTS=false
RESUME_STORE_ANONYMIZED_DOCUMENTS=false
RESUME_LOG_PII=false
RESUME_LOG_LEVEL=INFO
RESUME_MAX_UPLOAD_MB=10
RESUME_HISTORY_ENABLED=true
RESUME_VECTOR_STORE=memory
# RESUME_API_KEY=defina_somente_quando_expor_a_api
RESUME_REQUIRE_LOGIN=false
HF_HOME=.cache/huggingface
HF_HUB_OFFLINE=0
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
