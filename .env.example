RESUME_PROFILE=demo
RESUME_ENVIRONMENT=development
RESUME_ALLOWED_PROFILES=["demo","balanced","complete"]
RESUME_EMBEDDING_ENABLED=true
RESUME_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RESUME_EMBEDDING_BACKEND=torch
RESUME_EMBEDDING_DEVICE=cpu
RESUME_EMBEDDING_BATCH_SIZE=8
RESUME_NORMALIZE_EMBEDDINGS=true
RESUME_RERANKER_ENABLED=false
RESUME_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RESUME_RERANKER_TOP_N=3
RESUME_DOCLING_ENABLED=false
RESUME_PRESIDIO_ENABLED=false
RESUME_FULL_NER_ENABLED=false
RESUME_TOP_K=3
RESUME_MAX_REQUIREMENTS=30
RESUME_MAX_CHUNK_CHARS=420
RESUME_MAX_DOCUMENT_CHARS=30000
RESUME_MAX_JOB_CHARS=30000
RESUME_MAX_REVISIONS=1
RESUME_CACHE_ENABLED=true
RESUME_CACHE_BACKEND=memory
RESUME_CACHE_MAX_ENTRIES=128
RESUME_CACHE_TTL_SECONDS=86400
RESUME_STORE_RAW_DOCUMENTS=false
RESUME_STORE_ANONYMIZED_DOCUMENTS=false
RESUME_LOG_PII=false
RESUME_LOG_LEVEL=INFO
RESUME_MAX_UPLOAD_MB=10
RESUME_API_MAX_BODY_MB=1
RESUME_API_RATE_LIMIT_PER_MINUTE=60
RESUME_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
RESUME_HISTORY_ENABLED=true
RESUME_VECTOR_STORE=memory
# Em producao, RESUME_API_KEY e obrigatoria.
# RESUME_API_KEY=defina-uma-chave-forte
RESUME_REQUIRE_LOGIN=false
HF_HOME=.cache/huggingface
HF_HUB_OFFLINE=0
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
